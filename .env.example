# Console API connection (required)
ELEMENT_BASE_URL=https://1cmycloud.com
ELEMENT_CLIENT_ID=
ELEMENT_CLIENT_SECRET=

# TLS (optional; secure defaults are true)
# For a private CA: ELEMENT_CA_FILE=/path/to/internal-ca.pem
# For a trusted legacy CA rejected by Python 3.13 strict checks: ELEMENT_TLS_STRICT=false
# Last resort for an isolated test network only: ELEMENT_TLS_VERIFY=false
ELEMENT_TLS_VERIFY=true
ELEMENT_TLS_STRICT=true
ELEMENT_CA_FILE=

# Defaults (optional)
ELEMENT_APP_ID=
ELEMENT_PROJECT_ID=
ELEMENT_SPACE_ID=
