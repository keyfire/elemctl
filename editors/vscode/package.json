{
  "name": "xbsl-debug",
  "displayName": "XBSL Debug (1C:Element)",
  "description": "%ext.description%",
  "version": "0.2.1",
  "publisher": "keyfire",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0b0b16",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Debuggers"
  ],
  "keywords": [
    "1c",
    "1c-element",
    "xbsl",
    "debug"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/keyfire/elemctl.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/keyfire/elemctl/tree/main/editors/vscode",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onDebugResolve:xbsl",
    "onDebugDynamicConfigurations:xbsl"
  ],
  "contributes": {
    "breakpoints": [
      {
        "language": "xbsl"
      }
    ],
    "commands": [
      {
        "command": "xbslDebug.setup",
        "title": "%cmd.setup.title%"
      }
    ],
    "debuggers": [
      {
        "type": "xbsl",
        "label": "%debugger.label%",
        "languages": [
          "xbsl"
        ],
        "configurationAttributes": {
          "attach": {
            "properties": {
              "appId": {
                "type": "string",
                "description": "%attach.appId%"
              },
              "authMode": {
                "type": "string",
                "enum": [
                  "anonymous",
                  "another_user"
                ],
                "description": "%attach.authMode%"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "%attach.stopOnEntry%",
                "default": false
              },
              "workspace": {
                "type": "string",
                "description": "%attach.workspace%"
              },
              "envFile": {
                "type": "string",
                "description": "%attach.envFile%"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "xbsl",
            "request": "attach",
            "name": "%initial.attach.name%"
          }
        ],
        "configurationSnippets": [
          {
            "label": "%snippet.attach.label%",
            "description": "%snippet.attach.description%",
            "body": {
              "type": "xbsl",
              "request": "attach",
              "name": "%initial.attach.name%"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "XBSL Debug",
      "properties": {
        "xbslDebug.adapterPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.adapterPath%",
          "scope": "machine-overridable"
        },
        "xbslDebug.javaPath": {
          "type": "string",
          "default": "java",
          "description": "%config.javaPath%",
          "scope": "machine-overridable"
        },
        "xbslDebug.elemctlPath": {
          "type": "string",
          "default": "elemctl",
          "description": "%config.elemctlPath%",
          "scope": "machine-overridable"
        },
        "xbslDebug.openApplicationOnStart": {
          "type": "boolean",
          "default": true,
          "description": "%config.openApplicationOnStart%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "check": "tsc --noEmit",
    "package": "vsce package --no-dependencies -o xbsl-debug.vsix",
    "publish:vsce": "vsce publish --no-dependencies --skip-duplicate",
    "publish:ovsx": "ovsx publish xbsl-debug.vsix --skip-duplicate"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3",
    "esbuild": "^0.23",
    "ovsx": "^0.9",
    "typescript": "^5"
  },
  "l10n": "./l10n"
}
